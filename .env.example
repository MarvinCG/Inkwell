# Shared secret every device enters under Settings → Sync token.
# Generate one with:  openssl rand -hex 24
SYNC_TOKEN=change-me-to-a-long-random-string

# Largest single sync request in MB (notes with many photos / voice memos are big).
MAX_BODY_MB=50

# Only if you host the web app on a different origin than this server:
# CORS_ORIGIN=https://notes.example.com
